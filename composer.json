{
    "name": "componenta/queue",
    "description": "Independent message queue contracts, processing and recovery for PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "ext-json": "*",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^4.7",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Queue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress",
        "bench": "phpbench run --report=aggregate",
        "check": [
            "@test",
            "@analyse",
            "@cs:check"
        ],
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
